# Local development uses persistent embedded PostgreSQL; no server install required.
LOCAL_PGLITE=1
PGLITE_DATA_DIR=.data/postgres

# Set DATABASE_URL and disable LOCAL_PGLITE when using external PostgreSQL.
DATABASE_URL=

# Initial admin account (used by npm run admin:create)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Admin session signing secret — set a long random string in production
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# PhonePe Payment Gateway V2 – OAuth2 credentials (server-side only)
# Get credentials from https://developer.phonepe.com/ → Developer Settings
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Set to PRODUCTION when going live; defaults to SANDBOX
PHONEPE_ENV=SANDBOX

# Supabase Storage for durable production product images
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Customer email notifications when an admin updates order status
RESEND_API_KEY=
ORDER_EMAIL_FROM=NAADE <orders@your-verified-domain.example>

# Used for canonical SEO URLs and sitemap links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business customer-facing number for prefilled checkout link (country code + number)
NEXT_PUBLIC_NAADE_WHATSAPP_NUMBER=918555909550

# ==============================================================================
# Supabase Edge Functions — Meta WhatsApp Cloud API Secrets (Server-Side Only)
# Configure in Supabase Dashboard -> Edge Functions -> Secrets, or via:
# supabase secrets set WHATSAPP_ACCESS_TOKEN=...
# ==============================================================================
# WHATSAPP_ACCESS_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=100000000000000
# WHATSAPP_BUSINESS_ACCOUNT_ID=100000000000000
# WHATSAPP_APP_SECRET=your_meta_app_secret
# WHATSAPP_VERIFY_TOKEN=your_custom_random_verification_token
# WHATSAPP_API_VERSION=v21.0
# Merchant UPI ID & Payee details for Direct UPI Orders
NAADE_UPI_ID=8555909550@ybl
NEXT_PUBLIC_NAADE_UPI_ID=8555909550@ybl
NAADE_UPI_PAYEE_NAME=NAADE
NEXT_PUBLIC_NAADE_UPI_PAYEE_NAME=NAADE
