# Local development uses persistent embedded PostgreSQL; no server install required.
LOCAL_PGLITE=1
PGLITE_DATA_DIR=.data/postgres

# Set DATABASE_URL and disable LOCAL_PGLITE when using external PostgreSQL.
DATABASE_URL=

# Initial admin account (used by npm run admin:create)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Admin session signing secret — set a long random string in production
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# PhonePe Payment Gateway V2 – OAuth2 credentials (server-side only)
# Get credentials from https://developer.phonepe.com/ → Developer Settings
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Set to PRODUCTION when going live; defaults to SANDBOX
PHONEPE_ENV=SANDBOX

# Supabase Storage for durable production product images
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Customer email notifications when an admin updates order status
RESEND_API_KEY=
ORDER_EMAIL_FROM=NAADE <orders@your-verified-domain.example>

# Used for canonical SEO URLs and sitemap links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business number for manual UPI checkout (country code + number without plus or dashes)
NEXT_PUBLIC_NAADE_WHATSAPP_NUMBER=919000000000

